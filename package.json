{
  "name": "echo-game",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"cargo run -p echo-server\" \"vite\"",
    "build:client": "tsc --noEmit && vite build",
    "build:server": "cargo build --release --locked -p echo-server",
    "build": "pnpm run build:client && pnpm run build:server",
    "start": "node scripts/play.mjs",
    "play": "pnpm run build && pnpm start",
    "share": "pnpm run build && node scripts/play.mjs --share",
    "share:built": "node scripts/play.mjs --share",
    "test": "pnpm run test:ts && pnpm run test:tools && pnpm run test:rust",
    "test:ts": "tsx --test tests/*.test.ts",
    "test:rust": "cargo test --workspace --locked",
    "test:tools": "node scripts/quality/test-tools.mjs",
    "test:network": "cargo build --locked -p echo-server && node --test tests/network.integration.mjs",
    "test:e2e": "pnpm run build && pnpm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "lint": "pnpm run lint:ts && pnpm run lint:rust",
    "lint:ts": "node scripts/quality/lint.mjs",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all -- --check",
    "verify": "node scripts/quality/verify.mjs",
    "verify:quick": "node scripts/quality/verify.mjs --quick",
    "hooks:install": "node scripts/quality/install-hooks.mjs",
    "prepare": "node scripts/quality/install-hooks.mjs",
    "fixtures": "tsx scripts/movement-fixtures.ts && tsx scripts/gameplay-fixtures.ts",
    "fixtures:check": "node scripts/build-maps.mjs --check && tsx scripts/movement-fixtures.ts --check && tsx scripts/gameplay-fixtures.ts --check",
    "maps": "node scripts/build-maps.mjs",
    "test:launcher": "node --test tests/launcher.integration.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/three": "^0.183.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@10.23.0"
}
