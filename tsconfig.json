{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "isolatedModules": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["client", "shared", "server", "tests", "vite.config.ts", "playwright.config.ts"]
}
