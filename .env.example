# Used by the Rust server and local launcher. Do not commit .env.
HOST=127.0.0.1
PORT=3000
ECHO_DELAY_MS=3000
ECHO_ROUND_MS=180000
ECHO_SEEKERS=2
MAX_ROOMS=32
# Optional for direct hosting. pnpm run share generates a random key when empty.
ECHO_ACCESS_KEY=
# Optional permanent public HTTPS origin. Quick Tunnel registers its URL automatically.
ECHO_PUBLIC_URL=
# Extra exact browser origins, comma-separated. Same-host origins are accepted.
ALLOWED_ORIGINS=

# WebTransport UDP listener. Local launcher forces loopback; share defaults to 0.0.0.0.
# ECHO_WT_HOST=0.0.0.0
ECHO_WT_PORT=4433
# Required by share: https://YOUR-REACHABLE-UDP-HOST:4433/echo
ECHO_WT_PUBLIC_URL=
# Optional: set BOTH PEM paths for trusted TLS, or leave both unset for generated pins.
# ECHO_TLS_CERT=/path/to/cert.pem
# ECHO_TLS_KEY=/path/to/key.pem
# Optional complete shared/balance.json override:
# ECHO_BALANCE_FILE=/path/to/balance.json
